# Copy this file to .env and adjust for your machine.
# Defaults match docker-compose.yml.

PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=labuser
DB_PASSWORD=labpassword
DB_NAME=orders_lab

# TypeORM
DB_LOGGING=true
# Triggers [SLOW QUERY ALERT] if a query takes longer than this (ms)
DB_SLOW_QUERY_MS=100
